
/* CRD: 3D hard-hat robot avatar (bot-avatar.tsx robot variant) */
.rakazo-hh {
  perspective: 200px;
}

.rakazo-hh .rakazo-bot-avatar-eyes {
  transform-box: fill-box;
  transform-origin: center;
}

.rakazo-hh-body {
  transform-style: preserve-3d;
  transition:
    transform 350ms cubic-bezier(0.4, 0, 0.2, 1),
    filter 180ms cubic-bezier(0.4, 0, 0.2, 1);
  animation: rakazo-hh-bob 3.6s ease-in-out infinite;
}

.rakazo-hh:hover .rakazo-hh-body {
  transform: rotateY(-18deg) rotateX(8deg);
}

.rakazo-bot-avatar[data-working="true"] .rakazo-hh-body {
  animation-duration: 1.2s;
}

.rakazo-hh-lamp {
  opacity: 0.35;
  transition: opacity 180ms cubic-bezier(0.4, 0, 0.2, 1);
}

.rakazo-bot-avatar[data-working="true"] .rakazo-hh-lamp {
  animation: rakazo-hh-lamp 1s ease-in-out infinite;
}

@keyframes rakazo-hh-bob {
  0%,
  100% {
    translate: 0 0;
  }
  50% {
    translate: 0 -5%;
  }
}

@keyframes rakazo-hh-lamp {
  0%,
  100% {
    opacity: 0.4;
  }
  50% {
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .rakazo-hh-body,
  .rakazo-hh-lamp {
    animation: none;
    transition: none;
  }

  .rakazo-hh:hover .rakazo-hh-body {
    transform: none;
  }
}
