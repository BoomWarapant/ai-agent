#!/usr/bin/env python3
import io, os, re, sys, urllib.parse, urllib.request
from concurrent.futures import ThreadPoolExecutor

UA = {"User-Agent": "Mozilla/5.0"}
OUT = os.path.expanduser("~/work/gdrive")

def get(url):
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=60) as r:
        name = ""
        cd = r.headers.get("Content-Disposition", "")
        m = re.search(r"filename\*=UTF-8''([^;]+)", cd) or re.search(r'filename="([^"]+)"', cd)
        if m:
            name = urllib.parse.unquote(m.group(1))
            try:
                name = name.encode("latin-1").decode("utf-8")
            except (UnicodeEncodeError, UnicodeDecodeError):
                pass
        return r.read(), name

def fetch(fid):
    urls = [f"https://drive.usercontent.google.com/download?id={fid}&export=download&confirm=t",
            f"https://docs.google.com/document/d/{fid}/export?format=docx",
            f"https://docs.google.com/spreadsheets/d/{fid}/export?format=xlsx"]
    for u in urls:
        try:
            data, name = get(u)
        except Exception:
            continue
        if data[:15].lstrip().lower().startswith((b"<!doctype html", b"<html")):
            continue
        return data, name or fid
    raise RuntimeError("ดาวน์โหลดไม่ได้ (ไม่ใช่ลิงก์สาธารณะ หรือ ID ผิด)")

def text_of(data, name):
    low = name.lower()
    if data[:4] == b"%PDF":
        try:
            import pymupdf as fitz
        except ImportError:
            import fitz
        doc = fitz.open(stream=data, filetype="pdf")
        t = "\n".join(f"[หน้า {i + 1}]\n" + p.get_text() for i, p in enumerate(doc))
        return t if t.strip(" \n[]หน้า0123456789") else "(PDF เป็นภาพสแกน ไม่มีข้อความ — ต้องเปิดดูภาพ)"
    if data[:2] == b"PK" and (low.endswith(".xlsx") or b"xl/" in data[:4000]):
        import openpyxl
        wb = openpyxl.load_workbook(io.BytesIO(data), data_only=True, read_only=True)
        out = []
        for ws in wb.worksheets:
            out.append(f"[ชีต {ws.title}]")
            for row in ws.iter_rows(values_only=True):
                cells = ["" if v is None else str(v) for v in row]
                if any(cells):
                    out.append(" | ".join(cells).rstrip(" |"))
        return "\n".join(out)
    if data[:2] == b"PK":
        import docx
        d = docx.Document(io.BytesIO(data))
        out = [p.text for p in d.paragraphs if p.text.strip()]
        for t in d.tables:
            for r in t.rows:
                out.append(" | ".join(c.text.strip() for c in r.cells))
        return "\n".join(out)
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        return f"(ไฟล์ไบนารี {len(data)} ไบต์ — แปลงเป็นข้อความไม่ได้ เปิดจากไฟล์ที่บันทึกไว้)"

def norm(s):
    # PDF ภาษาไทยบางไฟล์ถอด "า" เป็น "ำ" และมีช่องว่างหน้า "ำ" — เทียบแบบหลวมเพื่อค้นคำเท่านั้น
    return re.sub(r"\s+", "", s.lower()).replace("ำ", "า")

def grep(text, words, ctx=2):
    lines = text.splitlines()
    keys = [norm(w) for w in words]
    keep = set()
    for i, ln in enumerate(lines):
        if any(k in norm(ln) for k in keys):
            keep.update(range(max(0, i - ctx), min(len(lines), i + ctx + 1)))
    if not keep:
        return "(ไม่พบคำค้นในไฟล์นี้)"
    out, prev = [], None
    for i in sorted(keep):
        if prev is not None and i != prev + 1:
            out.append("...")
        out.append(lines[i])
        prev = i
    return "\n".join(out)

def one(fid, words, limit):
    try:
        data, name = fetch(fid)
        os.makedirs(OUT, exist_ok=True)
        safe = re.sub(r"[/\\]", "_", name)
        path = os.path.join(OUT, f"{fid}-{safe}")
        with open(path, "wb") as f:
            f.write(data)
        t = text_of(data, name)
        if words:
            t = grep(t, words)
        if len(t) > limit:
            t = t[:limit] + f"\n...(ตัดที่ {limit} ตัวอักษร จากทั้งหมด {len(t)} — ใช้ --max หรือ --grep)"
        return f"===== {name} (ID {fid}) · บันทึกที่ {path}\n{t}"
    except Exception as e:
        return f"===== ID {fid}\nยังไม่สำเร็จ: {e}"

def main():
    args = sys.argv[1:]
    if not args:
        sys.exit("usage: gdread.py <FILE_ID> [FILE_ID ...] [--grep คำ ...] [--max ตัวอักษร]")
    limit, words, ids, mode = 8000, [], [], None
    for a in args:
        if a in ("--grep", "--max"):
            mode = a
        elif mode == "--max":
            limit, mode = int(a), None
        elif mode == "--grep":
            words.append(a.lower())
        else:
            ids.append(a)
    with ThreadPoolExecutor(6) as pool:
        for r in pool.map(lambda i: one(i, words, limit), ids):
            print(r + "\n")

main()
